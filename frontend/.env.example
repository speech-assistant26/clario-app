# Copy to `.env` for production builds. In dev, Vite proxies /api automatically.

# Backend origin used at build time (production). Leave blank to use same-origin.
# VITE_API_BASE=https://your-clario-api.example.com

# Dev-only: where the Vite proxy forwards /api (defaults to http://localhost:8000)
# VITE_API_TARGET=http://localhost:8000
