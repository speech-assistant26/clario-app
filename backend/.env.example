# Copy to `.env` and adjust as needed. All keys are optional.

# --- Artifacts ---
# CLARIO_MODEL_PATH=../models/phoneme_error_model.keras
# CLARIO_DATASET_NPZ_PATH=../data/phoneme_dataset.npz

# --- Normalization override ---
# The shipped data/phoneme_dataset.npz already supplies these, and the exact
# values are also baked into config.py as a fallback. Uncomment only to override.
# CLARIO_MEL_MEAN=-2.41279196739197
# CLARIO_MEL_STD=10.222767829895

# --- Decision threshold: 0.40 screening · 0.45 balanced · 0.50 precise (v8 default) ---
# CLARIO_ERROR_THRESHOLD=0.50
# CLARIO_MIN_ERROR_THRESHOLD=0.30   # clamp range for the client's sensitivity slider
# CLARIO_MAX_ERROR_THRESHOLD=0.70

# --- Audio quality gate (reject silence/background noise before analysis) ---
# CLARIO_ENABLE_QUALITY_GATE=true
# CLARIO_MIN_RMS_DBFS=-40.0         # quieter than this -> "too quiet" error
# CLARIO_MAX_NOISE_FLATNESS=0.6     # spectral flatness above this -> "just noise" error

# --- Target-word verification (Whisper ASR sanity check) ---
# CLARIO_ENABLE_WORD_VERIFICATION=true
# CLARIO_WHISPER_MODEL_NAME=openai/whisper-tiny.en
# CLARIO_WORD_MATCH_THRESHOLD=0.45

# --- Compute ---
# CLARIO_DEVICE=auto        # auto | cpu | cuda

# --- Server ---
# CLARIO_CORS_ORIGINS=http://localhost:5173
# CLARIO_MAX_UPLOAD_MB=25

# --- Sentence mode ---
# CLARIO_MAX_SENTENCE_WORDS=30
# CLARIO_WORD_PASS_ACCURACY=0.8     # a word is "correct" if >= this fraction of its phonemes are clear

# --- Accounts & history (Supabase) ---
# Leave unset to run without accounts/history. One-time: run backend/supabase/schema.sql
# in the Supabase SQL Editor. Values from Project Settings -> API Keys / Data API.
# CLARIO_SUPABASE_URL=https://<project-ref>.supabase.co
# CLARIO_SUPABASE_SERVICE_KEY=sb_secret_...        # the SECRET key, never the publishable one
# Long random string; generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# CLARIO_JWT_SECRET=change-me
# CLARIO_JWT_EXPIRE_DAYS=7
# CLARIO_STORE_AUDIO=true           # keep recordings (Supabase Storage) so users can replay attempts
